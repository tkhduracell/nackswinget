/* HEADER I MOBILEN */
#main-header {
    position: fixed;
}
.et_mobile_menu li a,
.nav li li a {
    font-size: 22px !important;
}
.et_mobile_menu li a {
    padding: 18px 4% !important;
}
.et_mobile_menu {
    position: fixed;
    overflow: scroll !important;
    max-height: 90vh;
    height: 750px;
}
.et_mobile_menu li a {
    padding: 16px 5% !important;
}
.et_mobile_menu .menu-item-has-children > a {
    background-color: rgba(0, 0, 0, 0) !important;
}
.et_mobile_menu li a,
.nav li li a {
    font-size: 16px !important;
}

/* BORDER-TOP PÅ MOBILMENYN */
.et_mobile_menu {
	    border-top: 3px solid #f9064b !important;
}