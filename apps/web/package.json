{
  "name": "@nackswinget/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:snapshot": "CONTENT_SOURCE=snapshot next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "export:wp": "tsx scripts/wp-export.ts",
    "import": "tsx scripts/import-snapshot.ts",
    "seo:fill": "tsx scripts/seo-fill.ts",
    "bigscreen:seed": "tsx scripts/bigscreen-seed.ts",
    "emulators": "cd ../.. && firebase emulators:start --only auth,firestore --project demo-nsw",
    "dev:emulators": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8085 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIREBASE_PROJECT_ID=demo-nsw NEXT_PUBLIC_EMULATORS=1 IMPORT_TOKEN=local-dev-token CRON_TOKEN=local-cron-token SMTP_URL=log ADMIN_EMAILS=admin@example.test next dev",
    "build:fixture": "CONTENT_SOURCE=snapshot CONTENT_SNAPSHOT=test/fixtures/snapshot.json next build",
    "e2e": "playwright test",
    "lighthouse:budget": "node scripts/lighthouse-budget.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.1",
    "linkedom": "^0.18.14",
    "minisearch": "^7.2.0",
    "next": "16.4.2",
    "nodemailer": "^10.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chrome-launcher": "^1.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "lighthouse": "13.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22 <25"
  }
}
